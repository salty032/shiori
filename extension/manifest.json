{
  "manifest_version": 3,
  "name": "Shiori companion",
  "key": "",
  "version": "0.4.1",
  "description": "Shioriアプリと連携してコマ送り・タイムコード送信を行う",
  "permissions": ["tabs", "windows"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://*.dmm.com/*",
    "*://*.dmm.co.jp/*",
    "*://*.animestore.docomo.ne.jp/*",
    "*://*.abema.tv/*",
    "*://*.nicovideo.jp/*",
    "*://*.unext.jp/*",
    "*://*.netflix.com/*",
    "*://*.amazon.co.jp/*",
    "*://*.primevideo.com/*",
    "*://*.disneyplus.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://*.dmm.com/*",
        "*://*.dmm.co.jp/*",
        "*://*.animestore.docomo.ne.jp/*",
        "*://*.abema.tv/*",
        "*://*.nicovideo.jp/*",
        "*://*.unext.jp/*",
        "*://*.netflix.com/*",
        "*://*.amazon.co.jp/*",
        "*://*.primevideo.com/*",
        "*://*.disneyplus.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
