{
  "manifest_version": 3,
  "name": "Shiori Link",
  "key": "",
  "version": "1.1.0",
  "description": "Shioriアプリと連携してコマ送り・タイムコード送信を行う",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["tabs", "windows"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://*.dmm.com/*",
    "*://*.dmm.co.jp/*",
    "*://*.animestore.docomo.ne.jp/*",
    "*://*.abema.tv/*",
    "*://*.nicovideo.jp/*",
    "*://*.unext.jp/*",
    "*://*.netflix.com/*",
    "*://*.amazon.co.jp/*",
    "*://*.primevideo.com/*",
    "*://*.disneyplus.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://*.dmm.com/*",
        "*://*.dmm.co.jp/*",
        "*://*.animestore.docomo.ne.jp/*",
        "*://*.abema.tv/*",
        "*://*.nicovideo.jp/*",
        "*://*.unext.jp/*",
        "*://*.netflix.com/*",
        "*://*.amazon.co.jp/*",
        "*://*.primevideo.com/*",
        "*://*.disneyplus.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["netflix-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
